# ============================================================
# 使用方法：把本文件复制为 .env，然后填写真实值。
# .env 已被 .gitignore 排除 —— 密钥永远不会进 git。
# ============================================================

# 客户端连网关用的自发 key（自己编一个长随机串即可，比如 sk-gw-开头）
GATEWAY_API_KEY=sk-gw-change-me

# ---- M0 阶段：单一测试上游（先配一个就够，比如英伟达 NIM）----
# OpenAI 兼容根地址（英伟达是 https://integrate.api.nvidia.com/v1）
UPSTREAM_BASE_URL=
# 对应的 API key
UPSTREAM_API_KEY=
# 要用的真实模型 id（去该厂商模型目录里抄，如英伟达的 Kimi/DeepSeek 系列）
UPSTREAM_MODEL=
